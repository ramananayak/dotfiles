# Options in [client] apply to all mysql tools (mysql, mysqldump, mysqladmin, ...)
# Options in [mysql] apply only to the interactive `mysql` client.
[mysql]
# Visuals — interactive-only
table
show-warnings

# History settings
# MySQL usually stores history in ~/.mysql_history by default
# to store history in .cache/ add this in .zshrc
# export MYSQL_HISTFILE="$HOME/.cache/mysql/.mysql_history"
